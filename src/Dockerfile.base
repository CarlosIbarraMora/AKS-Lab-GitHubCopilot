FROM python:3.11-slim AS builder

ENV UV_SYSTEM_PYTHON=1
RUN python -m pip install --no-cache-dir uv
RUN uv pip install --system \
    agent-framework-core \
    agent-framework-github-copilot \
    azure-identity \
    azure-keyvault-secrets \
    fastapi \
    httpx \
    "mcp>=1,<2" \
    opentelemetry-api \
    opentelemetry-sdk \
    pydantic \
    pydantic-settings \
    structlog \
    uvicorn

FROM python:3.11-slim AS runtime

LABEL org.opencontainers.image.source="https://github.com/kinfey/AKS-Lab-GitHubCopilot"

ENV HOME=/home/zava \
    XDG_CACHE_HOME=/home/zava/.cache \
    COPILOT_CLI_EXTRACT_DIR=/opt/copilot-cli \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN useradd --uid 10001 --home /home/zava --create-home zava \
    && mkdir -p /home/zava/.cache /app \
    && chown -R 10001:10001 /home/zava /app
WORKDIR /app

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin/uvicorn /usr/local/bin/uvicorn

# Bake the Copilot CLI runtime into the image so pods don't download it on every start
# (outside $XDG_CACHE_HOME, which the Helm chart mounts as an emptyDir).
RUN python -m copilot download-runtime && chmod -R a+rX /opt/copilot-cli

COPY src /app/src

USER 10001:10001
EXPOSE 8000
